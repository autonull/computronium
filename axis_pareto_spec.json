{
  "version": 2,
  "profile": "axis-aligned-pareto",
  "task": "digits",
  "objectives": [
    "validation_accuracy",
    "walltime_total",
    "param_count",
    "energy_per_step",
    "spectral_radius",
    "max_singular_value",
    "settle_steps",
    "free_energy",
    "lyapunov_exponent"
  ],
  "fidelity": "L1",
  "n_seeds": 1,
  "epochs": 3,
  "budget_seconds": 7200,
  "param_budget": 100000,
  "policy": "model_based",
  "axes": [
    {"axis": "substrate", "primitives": ["digital"]},
    {"axis": "geometry", "primitives": ["feedforward", "recurrent"]},
    {"axis": "dynamics", "primitives": ["energy_minimization", "instantaneous", "lazy"]},
    {"axis": "plasticity", "primitives": ["null"]},
    {"axis": "credit", "primitives": ["gradient", "thermodynamic_contrast", "random_projections", "pepita", "local_goodness"]},
    {"axis": "update", "primitives": ["euclidean", "adam", "muon"]}
  ],
  "hyperparameters": {
    "hidden_dim": {"lo": 32.0, "hi": 256.0, "scale": "log"},
    "num_layers": {"lo": 1.0, "hi": 6.0, "scale": "linear"},
    "settle_step": {"lo": 0.01, "hi": 1.0, "scale": "log"},
    "settle_beta": {"lo": 0.1, "hi": 1.0, "scale": "linear"},
    "feedback_scale": {"lo": 0.001, "hi": 1.0, "scale": "log"},
    "credit_norm": {"members": ["none", "relative", "rms", "beta_adaptive", "spectral"]},
    "local_objective": {"members": ["ff", "lemma"]},
    "update_lr": {"lo": 0.001, "hi": 0.1, "scale": "log"},
    "momentum": {"lo": 0.0, "hi": 0.99, "scale": "linear"}
  },
  "axis_objectives": {
    "task": ["validation_accuracy", "validation_loss"],
    "cost": ["walltime_total", "param_count", "energy_per_step"],
    "stability": ["spectral_radius", "max_singular_value", "settle_steps", "free_energy", "lyapunov_exponent"]
  },
  "deterministic": true,
  "num_workers": 0,
  "sweep_steps": 50
}