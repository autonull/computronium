{
  "version": 2,
  "profile": "axis_aligned_pareto",
  "task": "digits",
  "objectives": [
    "validation_accuracy",
    "walltime_total",
    "param_count",
    "spectral_radius",
    "max_singular_value",
    "settle_steps",
    "energy_per_step",
    "free_energy",
    "lyapunov_exponent"
  ],
  "axis_objectives": {
    "task": ["validation_accuracy", "validation_loss"],
    "cost": ["walltime_total", "param_count", "energy_per_step"],
    "stability": ["spectral_radius", "max_singular_value", "settle_steps", "free_energy", "lyapunov_exponent"]
  },
  "stages": [
    "s1_frame",
    "s2_space",
    "s3_schedule",
    "s4_gate",
    "s5_compose",
    "s6_train",
    "s7_measure",
    "s8_record",
    "s9_attribute",
    "s10_decide",
    "s11_report"
  ],
  "fidelity": "L1",
  "n_seeds": 1,
  "epochs": 3,
  "budget_seconds": 1800,
  "param_budget": 10000,
  "policy": "model_based",
  "axes": [
    {"axis": "substrate", "primitives": ["digital"]},
    {"axis": "geometry", "primitives": ["feedforward", "recurrent"]},
    {"axis": "dynamics", "primitives": ["energy_minimization", "instantaneous", "lazy"]},
    {"axis": "plasticity", "primitives": ["null"]},
    {"axis": "credit", "primitives": ["gradient", "thermodynamic_contrast", "random_projections", "pepita", "local_goodness"]},
    {"axis": "update", "primitives": ["euclidean", "adam", "muon"]}
  ],
  "hyperparameters": {
    "hidden_dim": {"lo": 8, "hi": 128, "scale": "log"},
    "settle_step": {"lo": 0.001, "hi": 0.5, "scale": "log"}
  },
  "operating_points": {},
  "deterministic": true,
  "num_workers": 0
}
