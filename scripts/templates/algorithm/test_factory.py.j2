"""Factory tests for {{ class_name }} algorithm."""

import torch

from computronium.algorithms.{{ name }} import {{ factory }}


def test_{{ factory }}_creates_system():
    """Test that factory creates a working system."""
    system = {{ factory }}(
        input_dim=4,
        hidden_dims=(8,),
        output_dim=4,
        lr=1e-3,
        device="cpu",
    )

    assert system is not None
    assert hasattr(system, "train_step")
    assert hasattr(system, "forward")


def test_{{ factory }}_train_step():
    """Test that factory system can run train_step."""
    system = {{ factory }}(
        input_dim=4,
        hidden_dims=(8,),
        output_dim=4,
        lr=1e-3,
        device="cpu",
    )

    x = torch.randn(2, 4)
    y = torch.randint(0, 4, (2,))

    result = system.train_step(x, y)

    assert result is not None
    assert isinstance(result, dict)
    assert "loss" in result


def test_{{ factory }}_backend_selection():
    """Test that backend parameter is accepted."""
    # Test reference backend
    system_ref = {{ factory }}(
        input_dim=4,
        hidden_dims=(8,),
        output_dim=4,
        lr=1e-3,
        device="cpu",
        backend="reference",
    )
    assert system_ref is not None

    # Test auto backend
    system_auto = {{ factory }}(
        input_dim=4,
        hidden_dims=(8,),
        output_dim=4,
        lr=1e-3,
        device="cpu",
        backend="auto",
    )
    assert system_auto is not None